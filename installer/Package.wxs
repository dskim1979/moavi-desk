<!-- MOAVI Desk MSI: moavi-desk.exe in Program Files\MOAVI Desk, a Start menu shortcut and,
     when built with VirtViewerDir, virt-viewer under <install>\virt-viewer (MoaviViewer.FindViewer looks there first). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MOAVI Desk"
           Manufacturer="(주)매커스시스템즈"
           Version="$(Version)"
           UpgradeCode="d7d8388c-419c-4af6-bd77-c2dc2430902e"
           Language="1042"
           Codepage="949"
           Scope="perMachine">
    <SummaryInformation Description="MOAVI Desk Client" Manufacturer="(주)매커스시스템즈" />

    <MajorUpgrade DowngradeErrorMessage="더 새로운 버전의 [ProductName]이(가) 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="moavi.ico" SourceFile="$(RepoDir)src\MoaviDesk\moavi.ico" />
    <Property Id="ARPPRODUCTICON" Value="moavi.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.makussystems.co.kr/" />
    <Property Id="ARPHELPLINK" Value="https://support.makussystems.co.kr/" />

    <!-- Unattended install for a room's PCs (README "실습실 PC에 한꺼번에 설치"):
           msiexec /i MOAVI-Desk-<version>-x64.msi /qn SERVER=desk.example.com PORT=443 HTTPS=1 KIOSK=1 ENROLL_CODE=MDE-XXXX-XXXX-XXXX
         The values go to the PC's shared config, %ProgramData%\MOAVI Desk\config, which wins over each user's
         own settings and is locked in Settings; ENROLL_CODE goes to %ProgramData%\MOAVI Desk\terminal, from
         which the client enrols on its first start. A property left out keeps what the PC has (upgrades). -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="PORT" Secure="yes" />
    <Property Id="HTTPS" Secure="yes" />
    <Property Id="KIOSK" Secure="yes" />
    <Property Id="ENROLL_CODE" Secure="yes" Hidden="yes" />
    <!-- the kiosk admin password as moavi-desk keeps it (PBKDF2 iterations.salt.hash), e.g. from the console's install command -->
    <Property Id="KIOSK_PASSWORD_HASH" Secure="yes" Hidden="yes" />

    <!-- moavi-desk.exe writes them (Config/MachineConfig.cs, MachineSetup) as SYSTEM after the files are in;
         a failure rolls the installation back -->
    <CustomAction Id="WriteMachineConfig"
                  FileRef="moavi_desk.exe"
                  ExeCommand="--machine-config --server &quot;[SERVER]&quot; --port &quot;[PORT]&quot; --https &quot;[HTTPS]&quot; --kiosk &quot;[KIOSK]&quot; --enroll-code &quot;[ENROLL_CODE]&quot; --kiosk-password-hash &quot;[KIOSK_PASSWORD_HASH]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <!-- an uninstall (not the one inside an upgrade) takes the shared config, the terminal's key with it -->
    <CustomAction Id="RemoveMachineConfig"
                  FileRef="moavi_desk.exe"
                  ExeCommand="--machine-config --remove"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="WriteMachineConfig" After="InstallFiles"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (SERVER OR PORT OR HTTPS OR KIOSK OR ENROLL_CODE OR KIOSK_PASSWORD_HASH)" />
      <Custom Action="RemoveMachineConfig" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MOAVI Desk">
        <?ifdef VirtViewerDir?>
        <Directory Id="VIRTVIEWERFOLDER" Name="virt-viewer" />
        <?endif?>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="MOAVI Desk" AllowAbsent="no">
      <Component Directory="INSTALLFOLDER">
        <File Id="moavi_desk.exe" Source="$(PublishDir)moavi-desk.exe" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(RepoDir)LICENSE.md" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(RepoDir)3rd-party-licenses.md" />
      </Component>

      <Component Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut"
                  Name="MOAVI Desk"
                  Description="MOAVI Desk Client"
                  Target="[INSTALLFOLDER]moavi-desk.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <!-- ICE38/ICE43: a component with a shortcut needs an HKCU keypath -->
        <RegistryValue Root="HKCU" Key="Software\Makus Systems\MOAVI Desk" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut"
                  Name="MOAVI Desk"
                  Description="MOAVI Desk Client"
                  Target="[INSTALLFOLDER]moavi-desk.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Makus Systems\MOAVI Desk" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="Software\Makus Systems\MOAVI Desk" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </Feature>

    <?ifdef VirtViewerDir?>
    <!-- virt-viewer (GPLv2+) and its GTK/SPICE libraries (LGPL) ship as their own feature; see virt-viewer\SOURCE.txt -->
    <Feature Id="VirtViewer" Title="virt-viewer (remote-viewer)" AllowAbsent="no">
      <Files Directory="VIRTVIEWERFOLDER" Include="$(VirtViewerDir)\**" />
    </Feature>
    <?endif?>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(RepoDir)installer\License.rtf" />
    <!-- MOAVI look for the wizard: navy picture on the welcome and finish pages, mark on the banner -->
    <WixVariable Id="WixUIDialogBmp" Value="$(RepoDir)installer\WixUIDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(RepoDir)installer\WixUIBanner.bmp" />
  </Package>
</Wix>
