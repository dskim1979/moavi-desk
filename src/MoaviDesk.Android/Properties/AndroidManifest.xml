<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- which app opens a .vv (SPICE) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/x-virt-viewer" />
    </intent>
  </queries>
  <application android:label="MOAVI Desk" android:icon="@drawable/icon" android:allowBackup="false">
    <provider android:name="androidx.core.content.FileProvider" android:authorities="com.makussystems.moavidesk.files"
              android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/moavi_files" />
    </provider>
    <!-- FreeRDP's own launcher shortcuts are not MOAVI Desk's -->
    <activity android:name="com.freerdp.freerdpcore.presentation.ShortcutsActivity" tools:node="remove" />
    <activity-alias android:name="com.freerdp.freerdpcore.presentation.CreateShortcuts" tools:node="remove" />
  </application>
</manifest>
