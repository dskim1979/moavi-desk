<Project>
  <PropertyGroup>
    <Version>0.9.0</Version>
    <Company>(주)매커스시스템즈</Company>
    <Authors>(주)매커스시스템즈</Authors>
    <Copyright>(주)매커스시스템즈</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Package metadata (used by libraries) -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dskim1979/moavi-desk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dskim1979/moavi-desk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>moavi.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols and Source Link (built into the .NET SDK) -->
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic build with normalized paths, only in CI -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
